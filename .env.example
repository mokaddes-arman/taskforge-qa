# Copy this file to .env and fill in an authorized QA account.
# Never commit the real .env file.
BASE_URL=https://mytaskforge.net/
owner_email=replace-with-authorized-qa-account@example.com
# Quote passwords that contain # (dotenv treats an unquoted # as a comment).
owner_password="replace-with-authorized-qa-password"
# Optional; defaults to /abdul-s-workspace
WORKSPACE_PATH=/abdul-s-workspace

# Optional run tuning (defaults shown). WORKERS=1 gives a serial run.
# WORKERS=4
# RETRIES=0
# Dashboard auto-open after a local run: auto | always | never
# DASHBOARD_OPEN=auto

# Platform (super) admin used by the RBAC suite to impersonate role accounts.
super_admin=
super_admin_password=
# QA accounts holding each workspace role (Admin/Manager created by
# scripts/provision-role-accounts.cjs; Employee is an existing test member).
qa_admin_email=
qa_admin_password=
qa_manager_email=
qa_manager_password=
qa_employee_email=
